# Leave both empty to use a local SQLite file (local.db).
# For production, point these at a Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. The seeded phone numbers are made up; set this to send every
# WhatsApp button to one number you own (international format, e.g. +971501234567).
DEMO_PHONE=
